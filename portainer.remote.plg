<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [<!ENTITY name "portainer.remote"><!ENTITY version "0.1.2"><!ENTITY package "portainer.remote-0.1.2.txz"><!ENTITY base "https://github.com/masterherby88/unraid-portainer-remote/releases/latest/download">]>
<PLUGIN name="&name;" author="community" version="&version;" pluginURL="https://raw.githubusercontent.com/masterherby88/unraid-portainer-remote/main/portainer.remote.plg" support="https://github.com/masterherby88/unraid-portainer-remote/issues">
  <CHANGES>
    ## &version;
    - Register the Settings form as a PHP page and render the dashboard widget through Unraid's custom-tile API.
  </CHANGES>
  <FILE Run="/bin/bash">
    <INLINE>mkdir -p /boot/config/plugins/&name;</INLINE>
  </FILE>
  <FILE Name="/boot/config/plugins/&name;/&package;" Run="upgradepkg --install-new">
    <URL>&base;/&package;</URL>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE>rm -rf /usr/local/emhttp/plugins/&name;</INLINE>
  </FILE>
</PLUGIN>
